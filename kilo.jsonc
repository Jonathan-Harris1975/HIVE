{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "*": "allow",
    "edit": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny",
      ".github/production-governance.json": "deny"
    },
    "write": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny",
      ".github/production-governance.json": "deny"
    },
    "apply_patch": {
      "*": "allow",
      "kilo.jsonc": "deny",
      ".github/workflows/*": "deny",
      ".github/actions/*": "deny",
      ".github/scripts/*": "deny",
      ".github/CODEOWNERS": "deny",
      ".github/dependabot.yml": "deny",
      ".mergify.yml": "deny",
      "renovate.json": "deny",
      "SECURITY.md": "deny",
      "AUTONOMY.md": "deny",
      "CI_SETUP.txt": "deny",
      ".github/production-governance.json": "deny"
    },
    "external_directory": "deny",
    "question": "deny",
    "bash": {
      "*": "deny",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git rev-parse *": "allow",
      "git branch --show-current *": "allow",
      "git fetch *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git merge origin/main": "allow",
      "git merge --no-edit origin/main": "allow",
      "git merge --abort": "allow",
      "git push origin HEAD": "allow",
      "git push --set-upstream origin HEAD": "allow",
      "git push -u origin HEAD": "allow",
      "python -m pytest *": "allow",
      "python3 -m pytest *": "allow",
      "python -m ruff *": "allow",
      "python3 -m ruff *": "allow",
      "python -m mypy *": "allow",
      "python3 -m mypy *": "allow",
      "python -m pip install *": "allow",
      "python3 -m pip install *": "allow",
      "python scripts/*": "allow",
      "python3 scripts/*": "allow",
      "docker build *": "allow",
      "docker run *": "allow",
      "docker logs *": "allow",
      "git checkout main": "deny",
      "git checkout -B main *": "deny",
      "git checkout -b main *": "deny",
      "git switch main": "deny",
      "git switch -C main *": "deny",
      "git switch -c main *": "deny",
      "git push *:*": "deny",
      "git push +*": "deny",
      "git push --force": "deny",
      "git push -f": "deny",
      "git push --force-with-lease": "deny",
      "git push --mirror": "deny",
      "git push --delete": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny",
      "bash -c *": "deny",
      "sh -c *": "deny",
      "gh pr merge *": "deny",
      "koyeb *": "deny"
    }
  }
}
