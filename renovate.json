{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "after 8:30am and before 11:00am on saturday"
  ],
  "rangeStrategy": "replace",
  "platformAutomerge": false,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "labels": [
      "security",
      "dependency:auto-eligible"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 8:30am and before 11:00am on saturday"
    ],
    "automerge": false,
    "labels": [
      "dependency:auto-eligible"
    ]
  },
  "packageRules": [
    {
      "description": "Digest, pin and lock-file updates carry no release timestamp; do not let them sit permanently pending on the stability check",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false,
      "addLabels": [
        "dependency:auto-eligible"
      ]
    },
    {
      "description": "Mark patch, minor and digest updates (npm and GitHub Actions) once the stability window and required checks pass",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": false,
      "addLabels": [
        "dependency:auto-eligible"
      ]
    },
    {
      "description": "Keep major updates under manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "dependency:manual"
      ]
    }
  ]
}
