{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "after 12:00am and before 2:30am on sunday"
  ],
  "rangeStrategy": "replace",
  "platformAutomerge": false,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "automerge": true,
    "minimumReleaseAge": "0 days",
    "labels": [
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 12:00am and before 2:30am on sunday"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Digest, pin and lock-file updates carry no release timestamp; do not let them sit permanently pending on the stability check",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Automerge patch, minor and digest updates (npm and GitHub Actions) once the stability window and required checks pass",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr-comment"
    },
    {
      "description": "Keep major updates under manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "automergeType": "pr-comment",
  "automergeComment": "@mergifyio queue"
}
