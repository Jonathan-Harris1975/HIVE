{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "after 8:30am and before 11:00am on saturday"
  ],
  "rangeStrategy": "replace",
  "platformAutomerge": false,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "labels": [
      "security",
      "dependency:auto-eligible"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 8:30am and before 11:00am on saturday"
    ],
    "automerge": false,
    "labels": [
      "dependency:auto-eligible"
    ]
  },
  "packageRules": [
    {
      "description": "Renovate does not update the pip-compiled lock directly; pip-compile owns requirements.txt.",
      "matchManagers": [
        "pip_requirements"
      ],
      "enabled": false
    },
    {
      "description": "Digest, pin and lock-file updates carry no release timestamp; do not let them sit permanently pending on the stability check",
      "matchUpdateTypes": [
        "digest",
        "pinDigest",
        "lockFileMaintenance"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false,
      "addLabels": [
        "dependency:auto-eligible"
      ]
    },
    {
      "description": "Mark patch, minor and digest updates (npm and GitHub Actions) once the stability window and required checks pass",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": false,
      "addLabels": [
        "dependency:auto-eligible"
      ]
    },
    {
      "description": "Keep major updates under manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "dependency:manual"
      ]
    },
    {
      "description": "Keep Python below 3.15 while the validated production LiteLLM stack declares Python <3.15. Continue compatible patch and digest updates.",
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "Preserve the verified LiteLLM release compatible with the mandatory filelock 4.x security floor; review this ceiling with a validated upstream compatibility change.",
      "matchPackageNames": [
        "litellm"
      ],
      "allowedVersions": "<=1.103.2"
    }
  ],
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|\\/)requirements\\.txt$/"
    ]
  },
  "pip_requirements": {
    "enabled": false
  }
}
